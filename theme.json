{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "720px",
            "wideSize": "1200px"
        },
        "spacing": {
            "units": ["px", "%", "em", "rem", "vw"],
            "spacingSizes": [
                {"slug": "20", "size": "8px", "name": "Pequeno"},
                {"slug": "30", "size": "15px", "name": "Médio"},
                {"slug": "40", "size": "24px", "name": "Grande"},
                {"slug": "50", "size": "50px", "name": "Extra grande"}
            ]
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "'Barlow', sans-serif",
                    "slug": "barlow",
                    "name": "Barlow",
                    "fontFace": [
                        {"fontFamily": "Barlow", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-400-latin.woff2"]},
                        {"fontFamily": "Barlow", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-400-latin-ext.woff2"]},
                        {"fontFamily": "Barlow", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-500-latin.woff2"]},
                        {"fontFamily": "Barlow", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-500-latin-ext.woff2"]},
                        {"fontFamily": "Barlow", "fontStyle": "normal", "fontWeight": "600", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-600-latin.woff2"]},
                        {"fontFamily": "Barlow", "fontStyle": "normal", "fontWeight": "600", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-600-latin-ext.woff2"]},
                        {"fontFamily": "Barlow", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-700-latin.woff2"]},
                        {"fontFamily": "Barlow", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-700-latin-ext.woff2"]}
                    ]
                },
                {
                    "fontFamily": "'Oswald', sans-serif",
                    "slug": "oswald",
                    "name": "Oswald",
                    "fontFace": [
                        {"fontFamily": "Oswald", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/oswald-400-latin.woff2"]},
                        {"fontFamily": "Oswald", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/oswald-400-latin-ext.woff2"]},
                        {"fontFamily": "Oswald", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": ["file:./assets/fonts/oswald-500-latin.woff2"]},
                        {"fontFamily": "Oswald", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": ["file:./assets/fonts/oswald-500-latin-ext.woff2"]}
                    ]
                }
            ],
            "fontSizes": [
                {"slug": "small", "size": "13px", "name": "Pequeno"},
                {"slug": "medium", "size": "15px", "name": "Médio"},
                {"slug": "large", "size": "20px", "name": "Grande"},
                {"slug": "x-large", "size": "32px", "name": "Extra grande"}
            ]
        },
        "color": {
            "palette": [
                {
                    "slug": "ultimas",
                    "color": "#f42c1a",
                    "name": "Últimas notícias"
                },
                {
                    "slug": "dark",
                    "color": "#1b1b1b",
                    "name": "Dark"
                },
                {
                    "slug": "accent-text",
                    "color": "#c81f10",
                    "name": "Acento (texto acessível)"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "#000000",
            "text": "#ffffff"
        }
    }
}
