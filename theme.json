{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "720px",
            "wideSize": "1200px"
        },
        "spacing": {
            "units": ["px", "%", "em", "rem", "vw"],
            "spacingSizes": [
                {"slug": "20", "size": "8px", "name": "Pequeno"},
                {"slug": "30", "size": "15px", "name": "Médio"},
                {"slug": "40", "size": "24px", "name": "Grande"},
                {"slug": "50", "size": "50px", "name": "Extra grande"}
            ]
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "'Barlow', sans-serif",
                    "slug": "barlow",
                    "name": "Barlow"
                },
                {
                    "fontFamily": "'Oswald', sans-serif",
                    "slug": "oswald",
                    "name": "Oswald"
                }
            ],
            "fontSizes": [
                {"slug": "small", "size": "13px", "name": "Pequeno"},
                {"slug": "medium", "size": "15px", "name": "Médio"},
                {"slug": "large", "size": "20px", "name": "Grande"},
                {"slug": "x-large", "size": "32px", "name": "Extra grande"}
            ]
        },
        "color": {
            "palette": [
                {
                    "slug": "hardware",
                    "color": "#003791",
                    "name": "Hardware"
                },
                {
                    "slug": "valorant",
                    "color": "#129e11",
                    "name": "VALORANT"
                },
                {
                    "slug": "freefire",
                    "color": "#e40b20",
                    "name": "Free Fire"
                },
                {
                    "slug": "ultimas",
                    "color": "#f42c1a",
                    "name": "Últimas notícias"
                },
                {
                    "slug": "dark",
                    "color": "#1b1b1b",
                    "name": "Dark"
                },
                {
                    "slug": "accent-text",
                    "color": "#c81f10",
                    "name": "Acento (texto acessível)"
                }
            ]
        }
    }
}
